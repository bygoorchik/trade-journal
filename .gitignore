# виртуальное окружение — у каждого своё, создаётся заново
.venv/

# служебные файлы Python
__pycache__/
*.pyc

# результаты работы скрипта — их всегда можно получить заново
output/

# личный журнал со сделками — приватные данные
data/journal.xlsx

# временные файлы офисных программ
.~lock.*
~$*

# настройки редактора
.vscode/
